<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageDir Condition="'$(PackageDir)' == ''">../../install</PackageDir>
    </PropertyGroup>
    <ItemGroup>
        <Reference Include="MFAAvalonia.Core"><HintPath>$(PackageDir)/libs/MFAAvalonia.Core.dll</HintPath></Reference>
        <Reference Include="MaaFramework.Binding.Native"><HintPath>$(PackageDir)/libs/MaaFramework.Binding.Native.dll</HintPath></Reference>
        <Reference Include="MaaFramework.Binding"><HintPath>$(PackageDir)/libs/MaaFramework.Binding.dll</HintPath></Reference>
        <Reference Include="Newtonsoft.Json"><HintPath>$(PackageDir)/libs/Newtonsoft.Json.dll</HintPath></Reference>
        <Reference Include="CommunityToolkit.Mvvm"><HintPath>$(PackageDir)/libs/CommunityToolkit.Mvvm.dll</HintPath></Reference>
    </ItemGroup>
</Project>
