{
    "StartUp": {
        "desc": "先处理已识别的游戏页面；其他画面再启动另一个伊甸，复用已有登录状态。",
        "next": [
            "StartUpCloseAnnouncement",
            "StartUpCloseMenasStages",
            "StartUpCloseLocalMap",
            "StartUpLoadGame",
            "StartUpWorldReady",
            "StartUpLaunch"
        ]
    },
    "StartUpLaunch": {
        "desc": "当前画面不属于已知游戏页面时启动应用一次，再沿既有流程核验主界面。",
        "action": "StartApp",
        "package": "com.xd.anothereden/net.wrightflyer.toybox.AppActivity",
        "max_hit": 1,
        "timeout": 180000,
        "next": [
            "StartUpCloseAnnouncement",
            "StartUpCloseMenasStages",
            "StartUpCloseLocalMap",
            "StartUpLoadGame",
            "StartUpWorldReady"
        ]
    },
    "StartUpLoadGame": {
        "desc": "仅在标题页的读取游戏按钮可见时点击；最多尝试三次。",
        "recognition": "TemplateMatch",
        "template": "Startup/LoadGame.png",
        "roi": [
            540,
            490,
            200,
            105
        ],
        "threshold": 0.85,
        "action": "Click",
        "max_hit": 3,
        "timeout": 180000,
        "next": [
            "StartUpCloseAnnouncement",
            "StartUpCloseMenasStages",
            "StartUpCloseLocalMap",
            "StartUpWorldReady",
            "StartUpLoadGame"
        ]
    },
    "StartUpCloseAnnouncement": {
        "desc": "匹配登录公告右上角的关闭按钮，不依赖会更新的公告正文。",
        "recognition": "TemplateMatch",
        "template": "Startup/AnnouncementClose.png",
        "roi": [
            975,
            10,
            140,
            70
        ],
        "method": 10001,
        "threshold": 0.9,
        "action": "Click",
        "max_hit": 3,
        "timeout": 120000,
        "next": [
            "StartUpCloseAnnouncement",
            "StartUpCloseMenasStages",
            "StartUpCloseLocalMap",
            "StartUpWorldReady"
        ]
    },
    "StartUpCloseMenasStages": {
        "desc": "恢复到梅纳斯试炼选关页时，标题、SS 标志和关闭键同时可见才返回主界面。",
        "recognition": "And",
        "all_of": [
            "MenasTrialStagesReady",
            "CatDiaryCloseButton"
        ],
        "box_index": 1,
        "action": "Click",
        "max_hit": 2,
        "timeout": 15000,
        "next": [
            "StartUpCloseAnnouncement",
            "StartUpCloseLocalMap",
            "StartUpWorldReady",
            "StartUpCloseMenasStages"
        ]
    },
    "StartUpCloseLocalMap": {
        "desc": "登录后恢复到展开的区域地图时，同时确认标题装饰和地图名称，再收起地图并核验主界面。",
        "recognition": "And",
        "all_of": [
            "NavigationLocalMap",
            {
                "recognition": "OCR",
                "roi": [15, 10, 640, 53],
                "expected": [".+"],
                "threshold": 0.8
            }
        ],
        "action": "Click",
        "target": [1150, 140],
        "max_hit": 1,
        "timeout": 15000,
        "next": [
            "StartUpCloseAnnouncement",
            "StartUpCloseMenasStages",
            "StartUpWorldReady"
        ]
    },
    "StartUpWorldReady": {
        "desc": "菜单与地图按钮同时可见才完成；亮度敏感匹配排除弹窗遮罩下的背景按钮。",
        "recognition": "And",
        "all_of": [
            {
                "recognition": "TemplateMatch",
                "template": "Startup/WorldMenu.png",
                "roi": [
                    25,
                    625,
                    120,
                    78
                ],
                "method": 10001,
                "threshold": 0.9
            },
            {
                "recognition": "TemplateMatch",
                "template": [
                    "Startup/WorldMap.png",
                    "Startup/WorldMapBright.png"
                ],
                "roi": [
                    235,
                    630,
                    85,
                    73
                ],
                "method": 10001,
                "threshold": [0.9, 0.97]
            }
        ]
    }
}
