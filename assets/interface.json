{
    "interface_version": 2,
    "name": "MAAEden",
    "icon": "logo.png",
    "description": "另一个伊甸自动化助手",
    "license": "MIT",
    "welcome": "请先在模拟器中手动完成账号登录，再运行启动并登录任务。",
    "github": "https://github.com/watershaymin/MAAEden",
    "version": "1.0.0",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "StartUp",
            "label": "启动并登录",
            "entry": "StartUp",
            "description": "启动另一个伊甸，读取当前账号存档、关闭登录公告，等待进入可操作的游戏主界面。适用于已登录账号的 16:9 横屏安卓设备；账号验证或未知弹窗请手动处理后重试。"
        },
        {
            "name": "MenasTrial",
            "label": "梅纳斯试炼",
            "entry": "MenasTrial",
            "description": "挑战 STAGE SS，每场消耗 1 张梅纳斯入场券。可指定次数，0 表示用完本次开始时持有的全部入场券；票不足时停止，不购买。战斗仅点击攻击，确认结算后计数并返回主界面。请提前设置队伍和技能预设。",
            "option": [
                "MenasTrialCount"
            ]
        },
        {
            "name": "MonthlyStarTrial",
            "label": "星天试炼·每月200胜",
            "entry": "MonthlyStarTrial",
            "description": "从主界面读取记录→勋章→试炼中的本月星天200胜进度，前往猫人世界晓之塔魔物巢穴补足剩余胜场。沿用当前队伍与技能；每25场复核进度，完成后停留试炼页。需已解锁目的地并预先配好可持续通关的队伍，最长运行180分钟。"
        },
        {
            "name": "MonthlyTrialDungeons",
            "label": "星天试炼·指定副本",
            "entry": "MonthlyTrialDungeons",
            "description": "从主界面或试炼页 OCR 读取本期三个副本目标，匹配副本跳过目录，仅对未达成且可跳过的副本各跳过一次，随后返回试炼页确认。包含普通开拓任务；不可跳过或名称无法唯一匹配的项目略过。未指定难度时优先低票数、困难。沿用当前队伍；消耗入场券和猫掌特急券，红绿票不足时沿用导证之力补充规则，不使用克洛诺斯之石；猫掌券不足则停止。奖励不自动领取。"
        },
        {
            "name": "CollectMail",
            "label": "领取邮件",
            "entry": "CollectMail",
            "description": "从主界面进入菜单和信箱，逐封领取未开封邮件的附件，确认没有未读邮件后返回主界面。已开封邮件会保留。"
        },
        {
            "name": "CatDiary",
            "label": "猫咪日记",
            "entry": "CatDiary",
            "description": "读取日记里的三只猫线索，传送到对应地点，通过区域地图追踪移动中的羽毛图例并交互。每次交互后重读日记，继续处理新地点，直到三只猫均结束；陌生地图、未解锁传送点或无法确认的状态会报告原因并停止。适用于1280×720横屏截图。",
            "option": [
                "CatDiaryTimeLimit"
            ]
        },
        {
            "name": "DungeonSkip",
            "label": "副本跳过",
            "entry": "DungeonSkip",
            "description": "自动前往次元夹缝蓝门，核对副本、难度和入场券后跳过指定次数。红票、绿票和猫掌券不足时，可分别选择是否使用星天之证的导证之力补充，默认不补充；未允许补充或额度不足时停止。禁止使用克洛诺斯之石。选项仅包含实机确认启用跳过的入口。",
            "option": [
                "DungeonTarget",
                "DungeonCount",
                "DungeonRefillRed",
                "DungeonRefillGreen",
                "DungeonRefillCat"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "{PROJECT_DIR}/agent/main.py"
        ]
    },
    "option": {
        "MenasTrialCount": {
            "type": "input",
            "label": "挑战次数",
            "inputs": [
                {
                    "name": "count",
                    "label": "次数（0＝全部入场券）",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^(0|[1-9][0-9]{0,2})$",
                    "pattern_msg": "请输入 0～999 的整数，0 表示用完全部入场券"
                }
            ],
            "pipeline_override": {
                "MenasTrial": {
                    "custom_action_param": {
                        "count": "{count}"
                    }
                }
            }
        },
        "CatDiaryTimeLimit": {
            "type": "select",
            "label": "寻猫运行上限",
            "default_case": "45",
            "cases": [
                {
                    "name": "15",
                    "label": "15分钟",
                    "pipeline_override": {
                        "CatDiary": {
                            "custom_action_param": {
                                "max_minutes": 15
                            }
                        }
                    }
                },
                {
                    "name": "45",
                    "label": "45分钟",
                    "pipeline_override": {
                        "CatDiary": {
                            "custom_action_param": {
                                "max_minutes": 45
                            }
                        }
                    }
                },
                {
                    "name": "90",
                    "label": "90分钟",
                    "pipeline_override": {
                        "CatDiary": {
                            "custom_action_param": {
                                "max_minutes": 90
                            }
                        }
                    }
                }
            ]
        },
        "NavigationDirection": {
            "type": "select",
            "label": "移动方向",
            "default_case": "left",
            "cases": [
                {
                    "name": "left",
                    "label": "左",
                    "pipeline_override": {
                        "NavigationMove": {
                            "custom_action_param": {
                                "direction": "left",
                                "duration": 600
                            }
                        }
                    }
                },
                {
                    "name": "right",
                    "label": "右",
                    "pipeline_override": {
                        "NavigationMove": {
                            "custom_action_param": {
                                "direction": "right",
