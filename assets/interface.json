{
    "interface_version": 2,
    "name": "MAAEden",
    "icon": "logo.png",
    "description": "另一个伊甸自动化助手",
    "license": "MIT",
    "welcome": "请先在模拟器中手动完成账号登录，再运行启动并登录任务。",
    "github": "https://github.com/watershaymin/MAAEden",
    "version": "1.0.0",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "StartUp",
            "label": "启动并登录",
            "entry": "StartUp",
            "description": "启动另一个伊甸，读取当前账号存档、关闭登录公告，等待进入可操作的游戏主界面。适用于已登录账号的 16:9 横屏安卓设备；账号验证或未知弹窗请手动处理后重试。"
        },
        {
            "name": "MenasTrial",
            "label": "梅纳斯试炼",
            "entry": "MenasTrial",
            "description": "从游戏主界面进入活动 → 梅纳斯试炼 → STAGE SS，消耗 1 张入场券完成一场挑战。战斗仅点击攻击，自动推进结算并返回主界面。请玩家提前设置队伍和技能预设；本任务不切换队伍，不购买入场券。"
        },
        {
            "name": "MonthlyStarTrial",
            "label": "星天试炼·每月200胜",
            "entry": "MonthlyStarTrial",
            "description": "从主界面读取记录→勋章→试炼中的本月星天200胜进度，前往猫人世界晓之塔魔物巢穴补足剩余胜场。沿用当前队伍与技能；每25场复核进度，完成后停留试炼页。需已解锁目的地并预先配好可持续通关的队伍，最长运行180分钟。"
        },
        {
            "name": "CollectMail",
            "label": "领取邮件",
            "entry": "CollectMail",
            "description": "从主界面进入菜单和信箱，逐封领取未开封邮件的附件，确认没有未读邮件后返回主界面。已开封邮件会保留。"
        },
        {
            "name": "NavigationMove",
            "label": "基础移动",
            "entry": "NavigationMove",
            "description": "从可操作主界面滑动一步，通过展开区域地图核对实际位移；撞墙或无法定位时失败停止。仅适配 16:9 横屏。",
            "option": [
                "NavigationDirection"
            ]
        },
        {
            "name": "NavigationTeleport",
            "label": "传送至巴尔沃基",
            "entry": "NavigationTeleport",
            "description": "打开世界地图，选择现代与巴尔沃基，核对确认弹窗，传送后验证区域地图名称。"
        },
        {
            "name": "NavigationBaruokiRoute",
            "label": "巴尔沃基寻路示例",
            "entry": "NavigationBaruokiRoute",
            "description": "先运行传送至巴尔沃基；从落点沿主路向左，在路口转向北侧道路，逐步读取区域地图定位。起点不符会停止。"
        },
        {
            "name": "DungeonEntrance",
            "label": "前往副本蓝门",
            "entry": "DungeonEntrance",
            "description": "独立前置：传送至次元夹缝，向左找到蓝门并交互，确认进入平行迷宫选图页。已在选图页时直接完成。"
        },
        {
            "name": "DungeonSkip",
            "label": "副本跳过",
            "entry": "DungeonSkip",
            "description": "进入次元夹缝蓝门，核对副本、难度和入场券后跳过指定次数。每次消耗入场券和猫掌特急券；红绿票不足时可使用导证之力补充，猫掌券不足则停止。禁止使用克洛诺斯之石。选项仅包含实机确认启用跳过的入口。",
            "option": [
                "DungeonTarget",
                "DungeonCount"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "{PROJECT_DIR}/agent/main.py"
        ]
    },
    "option": {
        "NavigationDirection": {
            "type": "select",
            "label": "移动方向",
            "default_case": "left",
            "cases": [
                {
                    "name": "left",
                    "label": "左",
                    "pipeline_override": {
                        "NavigationMove": {
                            "custom_action_param": {
                                "direction": "left",
                                "duration": 600
                            }
                        }
                    }
                },
                {
                    "name": "right",
                    "label": "右",
